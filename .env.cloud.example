# Required.
PROJECT_ID=your-gcp-project
REGION=us-central1

# Cloud Run deployment.
ACCELERATOR=gpu
MIN_INSTANCES=0
MAX_INSTANCES=1
PUBLIC=true

# Default model set. Keep these aligned with the vault config used by clients.
QWEN_MODEL=Qwen/Qwen3-4B-Instruct-2507
TEXT_MODEL=google/embeddinggemma-300m
IMAGE_MODEL=google/medsiglip-448

# HF_TOKEN is intentionally not stored here for deployment.
# Export it only while running scripts/deploy_secrets.sh:
# export HF_TOKEN=hf_...
